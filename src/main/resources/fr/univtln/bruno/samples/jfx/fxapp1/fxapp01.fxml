<?xml version="1.0" encoding="UTF-8"?>

<!-- 
  Simple JavaFX Student Task Manager
  A beginner-friendly example demonstrating key JavaFX concepts:
  - Layout containers and controls
  - Controller binding
  - Basic styling
  - Input validation
  - FXML structure
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.univtln.bruno.samples.jfx.fxapp1.Controller"
            stylesheets="styles.css">

    <!-- Header with application title -->
    <top>
        <VBox alignment="CENTER" styleClass="header">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15" />
            </padding>
            <Label text="Student Task Manager" styleClass="title-label">
                <font>
                    <Font name="System Bold" size="18"/>
                </font>
            </Label>
            <Label text="Add tasks to your study list" styleClass="subtitle-label"/>
        </VBox>
    </top>
    
    <!-- Main content area with the task list -->
    <center>
        <VBox spacing="10" styleClass="content-area">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <Label text="My Tasks:" styleClass="section-header"/>
            <ListView fx:id="taskListView" VBox.vgrow="ALWAYS" styleClass="task-list"/>
        </VBox>
    </center>
    
    <!-- Input area for adding new tasks -->
    <bottom>
        <VBox spacing="5" styleClass="input-area">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            
            <!-- Task input fields -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="New Task:" styleClass="input-label"/>
                <TextField fx:id="taskInputField" promptText="Enter task description" 
                          HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Status and action area -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="statusLabel" styleClass="status-label" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                    <Button fx:id="clearButton" text="Clear" styleClass="clear-button"/>
                    <Button fx:id="addButton" text="Add Task" styleClass="add-button" defaultButton="true"/>
                </HBox>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>