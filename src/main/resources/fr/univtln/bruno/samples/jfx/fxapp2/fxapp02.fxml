<?xml version="1.0" encoding="UTF-8"?>

<!--
  JavaFX FXML Layout for the MVC Sample Application
  Material-inspired design with improved usability and responsive layout
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Pagination?>

<BorderPane xmlns="http://javafx.com/javafx/21"
             xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="fr.univtln.bruno.samples.jfx.fxapp2.view.Controller"
             stylesheets="@styles.css">

    <!-- Header section with app branding and global controls -->
    <top>
        <VBox>
            <!-- Main header with title -->
            <StackPane styleClass="header" maxHeight="Infinity">
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <!-- App icon - using SVG for scalability -->
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 50;" minWidth="45" minHeight="45" maxWidth="45" maxHeight="45">
                        <SVGPath content="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                 fill="#1976d2" scaleX="1.5" scaleY="1.5"/>
                    </StackPane>

                    <!-- App title -->
                    <Label text="Person Database Viewer"
                           styleClass="title"
                           wrapText="true">
                        <font>
                            <Font name="System Bold" size="24"/>
                        </font>
                    </Label>
                    <HBox.margin>
                        <Insets right="20"/>
                    </HBox.margin>
                </HBox>
            </StackPane>

            <!-- Toolbar with actions -->
            <ToolBar styleClass="toolbar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Search:" style="-fx-font-weight: bold;"/>

                    <!-- Search field with icon placeholder -->
                    <HBox alignment="CENTER_LEFT" styleClass="search-field" spacing="10" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="8" bottom="8" left="15" right="15" />
                        </padding>

                        <!-- Search icon -->
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                 fill="#5f6368" />

                        <TextField fx:id="searchField"
                                   promptText="Search by name"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"
                                   style="-fx-background-color: transparent; -fx-padding: 0;"/>
                    </HBox>

                    <Button fx:id="searchButton"
                            text="Search"
                            defaultButton="true"
                            minWidth="100"
                            styleClass="search-button" />
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <!-- Main content area -->
    <center>
        <SplitPane dividerPositions="0.75" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-box-border: transparent;">
            <!-- Left side: Data panel with shadow effect -->
            <VBox styleClass="data-panel"
                  VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <!-- Data panel header with counter -->
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0;">
                    <!-- Data icon -->
                    <StackPane style="-fx-background-color: #e3f2fd; -fx-background-radius: 50;" minWidth="40" minHeight="40">
                        <SVGPath content="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z"
                                 fill="#1976d2"/>
                    </StackPane>

                    <VBox>
                        <Label text="Person Records" styleClass="header"/>
                        <Label text="Browse through the database records" styleClass="subheader"/>
                    </VBox>
                    <HBox HBox.hgrow="ALWAYS"/>
                </HBox>
                <Separator />

                <!-- Data content container - pagination will be added here programmatically -->
                <VBox fx:id="dataContainer" spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-padding: 15 0 0 0;">
                    <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-background-radius: 4;">
                        <Pagination fx:id="paginator" />
                    </StackPane>
                </VBox>
            </VBox>

            <!-- Right side: Results panel -->
            <VBox styleClass="results-panel"
                  VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

                <!-- Results panel header -->
                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0;">
                    <!-- Results icon -->
                    <StackPane style="-fx-background-color: #e8f5e9; -fx-background-radius: 50;" minWidth="40" minHeight="40">
                        <SVGPath content="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                 fill="#43a047"/>
                    </StackPane>

                    <VBox>
                        <Label text="Search Results" styleClass="header"/>
                        <Label text="Matching person records" styleClass="subheader"/>
                    </VBox>
                </HBox>
                <Separator />

                <!-- Results list with styled cells -->
                <ListView fx:id="searchList"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: transparent; -fx-padding: 10 0 0 0;" />

                <!-- Helper text with icon -->
                <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
                    <SVGPath content="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                             fill="#9e9e9e" scaleX="0.8" scaleY="0.8"/>
                    <Label text="Click on a result to view details"
                           style="-fx-font-style: italic; -fx-text-fill: #757575;"
                           wrapText="true" />
                </HBox>
            </VBox>

            <!-- Detail pane for selected person -->
            <VBox fx:id="detailPane" styleClass="detail-pane" spacing="10">
                <Label text="Person Details" styleClass="header"/>
                <Label fx:id="detailName" text="Name: " styleClass="label"/>
                <Label fx:id="detailAddress" text="Email: " styleClass="label"/>
                <Label fx:id="detailUUID" text="Phone: " styleClass="label"/>
            </VBox>
        </SplitPane>
    </center>

    <!-- Status bar -->
    <bottom>
        <HBox styleClass="status-bar">
            <padding>
                <Insets top="8" right="15" bottom="8" left="15" />
            </padding>
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label"/>
            <HBox HBox.hgrow="ALWAYS" />
        </HBox>
    </bottom>
</BorderPane>